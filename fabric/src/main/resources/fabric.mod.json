{
  "schemaVersion": 1,
  "id": "slugggaddons",
  "version": "${version}",
  "name": "SlugggAddons",
  "description": "Client-side Hypixel SkyBlock tweaks: a full profile viewer (/pv), item and recipe browser, player model and item animation tweaks, and positional party messages.",
  "authors": ["StreetInman"],
  "contact": {
    "sources": "https://github.com/StreetInman/skyblock-pv",
    "issues": "https://github.com/StreetInman/skyblock-pv/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.streetinman.skyblockpv.SkyblockPvClient"]
  },
  "mixins": ["skyblockpv.mixins.json", "skyblockpv.compat.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "${minecraft_range}",
    "java": ">=25"
  }
}
